# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations
# App code reads SUPABASE_SERVICE_KEY (Vercel must set this name)
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QuickBooks Online Integration
# Get these from your Intuit Developer account: https://developer.intuit.com
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox  # 'sandbox' or 'production'

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio - for SMS notifications
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
# Business-hours shop ring before the call rolls to Mike, in seconds the caller hears.
# Default 15. Twilio adds about 5 seconds to <Dial timeout>, so the app sends 10.
# The voice URLs already pass ?timeout=15, which means the same 15 seconds. Leave this unset.
# PHONE_CALL_RING_TIMEOUT=15

# Optional extra Twilio numbers whose outbound calls count as callbacks.
# The built-in tracking numbers (ads, website, GBP, Yelp, Apple Maps, direct) are always included.
# TWILIO_TRACKING_NUMBERS=+17603312502

# Staff Google Voice lines for outbound callback attribution.
# Replaces the defaults (Liz 619-320-8264, Shanicey 442-227-2898, Brighton email only) when set.
# Phone may be blank. Liz's Voice line logs almost no outbound calls; she likely dials from
# a phone that is not in the Voice audit log. Add that number here only once it is logged.
# VOICE_STAFF_LINES=Liz:lizbeth@scwellservice.com:+16193208264,Shanicey:shanicey@scwellservice.com:+14422272898,Brighton:brighton@scwellservice.com:

# Mike missed-call callbacks. Off unless one of these is set. The cron never dials while both are empty.
# Full mode dials every eligible missed caller. Test mode (flag unset) dials only the allowlist.
# MIKE_CALLBACKS_ENABLED=false
# MIKE_CALLBACK_TEST_NUMBERS=+17605550199
# Optional: MIKE_CALLBACK_OPEN=08:00  MIKE_CALLBACK_CLOSE=17:00  MIKE_CALLBACK_DAYS=Mon,Tue,Wed,Thu,Fri
# MIKE_CALLBACK_TZ=America/Los_Angeles  MIKE_CALLBACK_WAIT_MINUTES=5  MIKE_CALLBACK_MAX_PER_7_DAYS=2
# MIKE_CALLBACK_LOOKBACK_HOURS=96  MIKE_CALLBACK_MAX_PER_RUN=3
# MIKE_CALLBACK_HOLD_NAMES=Kevin Coleman|Steven payment plan
# MIKE_CALLBACK_DNC=+17605550100
# MIKE_VAPI_NUMBER=+17604915348

# Resend - for email notifications
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="Your Company Name"

# Cron Secret — MUST exist in Vercel Production env (Settings → Environment Variables).
# Name: CRON_SECRET. Do not commit the real value. Vercel Cron sends it as
# Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Google Business Profile — live ratings for GET /api/gbp-ratings
# OAuth client grok-bot-gbp (Cloud project scws-ads), scope business.manage.
# Set these on Vercel project scws-jobs. Do not commit real values.
GBP_CLIENT_ID=your-gbp-oauth-client-id
GBP_CLIENT_SECRET=your-gbp-oauth-client-secret
GBP_REFRESH_TOKEN=your-gbp-oauth-refresh-token
# Optional overrides (defaults are the SCWS Ramona + Anza locations)
# GBP_ACCOUNT_ID=accounts/109987064359914956127
# GBP_RAMONA_LOCATION_ID=locations/8959939212840285363
# GBP_ANZA_LOCATION_ID=locations/17699062318199230566
# GBP_RAMONA_REVIEW_URL=https://g.page/r/CU9X_NG3TvP2EBM/review
# GBP_ANZA_REVIEW_URL=

# Stax Payment Gateway
# Get these from your Stax dashboard: https://app.staxpayments.com
# Navigate to Apps > API Keys
STAX_API_KEY=your-stax-api-key
NEXT_PUBLIC_STAX_WEB_PAYMENTS_KEY=your-stax-web-payments-token
# Optional: Override API URL for sandbox
# STAX_API_URL=https://apisandbox.fattlabs.com

# GA4 Measurement Protocol — CRM book_job conversion (Jobber job first scheduled)
# Property G-5LL1YRWT5T. Create the API secret in GA4 Admin → Data streams →
# Measurement Protocol API secrets. Do not commit the real secret.
GA4_MEASUREMENT_ID=G-5LL1YRWT5T
GA4_MP_API_SECRET=

# Jobber GraphQL — book_job cron, Sarah checkSchedule / bookJob,
# unsent quote drafts (/api/jobber/tech-note-quote, /api/jobber/drill-quote),
# and the shared MCP gateway (/api/mcp/jobber). Do not commit real values.
JOBBER_ACCESS_TOKEN=
# OAuth refresh bootstrap. Access tokens expire in ~3600s. Jobber rotates
# refresh tokens on every use. Env values seed Supabase settings.jobber_oauth
# once, only when that row is empty. After that, nothing else may refresh
# Jobber — not a laptop, not a box script, not a second copy of these vars.
# See docs/JOBBER_OAUTH.md. Do not commit values.
JOBBER_REFRESH_TOKEN=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Required in Production. AES-256-GCM key material for settings.jobber_oauth.
# Generate with: openssl rand -hex 32
# Set on Vercel project scws-jobs (Production) and redeploy. Do not commit.
# Missing this in Production is a loud refresh error — not a silent env fallback.
JOBBER_TOKEN_ENCRYPTION_KEY=
# Optional GraphQL version override. Quote drafts default to 2025-04-16;
# Sarah booking defaults to 2026-02-17 if this is unset.
# JOBBER_GRAPHQL_VERSION=
# Optional Jobber tax rate GIDs. Prefer San Diego for Ramona/SD addresses.
# JOBBER_TAX_RATE_ID_SAN_DIEGO=
# JOBBER_TAX_RATE_ID_RIVERSIDE=
# JOBBER_TAX_RATE_ID_SAN_BERNARDINO=
# Internal quote GP tracker (/ops/quotes-gp). Office key — do not commit the
# real value. Open /ops/quotes-gp after CRM login, or /ops/quotes-gp?key=<this>.
# ADMIN_SECRET is accepted if this is unset.
# QUOTES_GP_KEY=

# Shared Jobber MCP gateway (/api/mcp/jobber). Named bearer keys for Travis /
# Damien / Brighton shop bots. Jobber OAuth stays on this app — never put
# JOBBER_* tokens on bot machines. JSON map preferred. Do not commit real keys.
# JOBBER_MCP_API_KEYS={"travis":"","damien":"","brighton":""}

# Optional salesperson override. When unset, drafts use the Jobber user named
# Brighton (info@scwellservice.com), then that known user id if the lookup fails.
# JOBBER_SALESPERSON_ID=
# Optional: pin Jobber user ids AFTER they resolve from this repo. Brian and
# Cowin match roster emails (brian@ / cowin@). Doug Pollack is not in
# scripts/seed-team.ts — match Brighton's exact name only. A pin that is not
# that person (e.g. Travis) refuses booking rather than assigning the wrong tech.
# JOBBER_TECH_BRIAN_EADS_ID=
# JOBBER_TECH_DOUG_POLLACK_ID=
# JOBBER_TECH_COWIN_ID=
# Optional pin for Jeremiah Biliunas (jeremiah@scwellservice.com), same pattern as
# the other JOBBER_TECH_*_ID keys. A pin that is not his Jobber user refuses him.
# JOBBER_TECH_JEREMIAH_BILIUNAS_ID=
# Sat/Sun service-call slots. Comma-separated exact Jobber names. Unset = no weekend
# slots. Do not set "all" or "*": an empty weekend board would look free for every
# tech in the pool. Brian and Cowin stay weekday-only unless their names are listed.
# Production, after the Jeremiah roster ships:
# RECEPTIONIST_WEEKEND_TECHS=Jeremiah Biliunas
# RECEPTIONIST_WEEKEND_TECHS=
