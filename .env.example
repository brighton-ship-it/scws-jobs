# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side operations
# App code reads SUPABASE_SERVICE_KEY (Vercel must set this name)
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QuickBooks Online Integration
# Get these from your Intuit Developer account: https://developer.intuit.com
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox  # 'sandbox' or 'production'

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio - for SMS notifications
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Resend - for email notifications
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="Your Company Name"

# Cron Secret — MUST exist in Vercel Production env (Settings → Environment Variables).
# Name: CRON_SECRET. Do not commit the real value. Vercel Cron sends it as
# Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Google Business Profile — live ratings for GET /api/gbp-ratings
# OAuth client grok-bot-gbp (Cloud project scws-ads), scope business.manage.
# Set these on Vercel project scws-jobs. Do not commit real values.
GBP_CLIENT_ID=your-gbp-oauth-client-id
GBP_CLIENT_SECRET=your-gbp-oauth-client-secret
GBP_REFRESH_TOKEN=your-gbp-oauth-refresh-token
# Optional overrides (defaults are the SCWS Ramona + Anza locations)
# GBP_ACCOUNT_ID=accounts/109987064359914956127
# GBP_RAMONA_LOCATION_ID=locations/8959939212840285363
# GBP_ANZA_LOCATION_ID=locations/17699062318199230566
# GBP_RAMONA_REVIEW_URL=https://g.page/r/CU9X_NG3TvP2EBM/review
# GBP_ANZA_REVIEW_URL=

# Stax Payment Gateway
# Get these from your Stax dashboard: https://app.staxpayments.com
# Navigate to Apps > API Keys
STAX_API_KEY=your-stax-api-key
NEXT_PUBLIC_STAX_WEB_PAYMENTS_KEY=your-stax-web-payments-token
# Optional: Override API URL for sandbox
# STAX_API_URL=https://apisandbox.fattlabs.com

# GA4 Measurement Protocol — CRM book_job conversion (Jobber job first scheduled)
# Property G-5LL1YRWT5T. Create the API secret in GA4 Admin → Data streams →
# Measurement Protocol API secrets. Do not commit the real secret.
GA4_MEASUREMENT_ID=G-5LL1YRWT5T
GA4_MP_API_SECRET=

# Jobber GraphQL — used by /api/cron/sync-jobber-book-jobs to poll recently updated jobs
JOBBER_ACCESS_TOKEN=
